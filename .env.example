# ==============================================================================
# NEEDORA PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Supported providers: Neon, Supabase, AWS RDS, Railway, Local PostgreSQL
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/needora?schema=public"

# Direct connection string for migrations if using connection poolers (PgBouncer/Supabase Pooler)
DIRECT_URL="postgresql://postgres:your_secure_password@localhost:5432/needora?schema=public"

# 2. APPLICATION CONFIGURATION
NEXT_PUBLIC_APP_URL="https://needora-theta.vercel.app"
NODE_ENV="production"

# 3. AUTHENTICATION & SECRETS
NEXTAUTH_SECRET="your_32_character_random_nextauth_secret_key_here"
JWT_SECRET="your_jwt_signing_secret_key_here"

# 4. OBJECT STORAGE (AWS S3 / Cloudflare R2 / Supabase Storage)
# Optional: if unconfigured, media uploads are served from local persistent directory /public/uploads/
STORAGE_PROVIDER="local"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET_NAME=""
NEXT_PUBLIC_CDN_URL=""

# 5. DORA AI SERVICE
# Optional external LLM API key (e.g. Gemini / OpenAI / Anthropic)
# Needora includes an intelligent local fallback query engine when unconfigured.
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# ==============================================================================
# IMPORTANT NOTICE:
# Needora is a 100% free discovery & customer enquiry platform.
# NO PAYMENT GATEWAY KEYS (Stripe, Razorpay, PhonePe, UPI) ARE REQUIRED OR ACCEPTED.
# ==============================================================================
